#!/bin/sh
# Her commit'te sürüm numarasını otomatik ata: v2.<commit sayısı>
# (bu commit dahil; workflow aynı sayıyı rev-list ile üretir)
count=$(git rev-list --count HEAD 2>/dev/null || echo 0)
version="v2.$((count + 1))"
file="v2_claude_code_local/version.js"
cat > "$file" <<JS
// Otomatik üretilir (.githooks/pre-commit ve GitHub Actions). Elle düzenlemeyin.
window.APP_VERSION = '$version';
document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('appVersion');
    if (el) el.textContent = window.APP_VERSION;
});
JS
git add "$file"
echo "Sürüm: $version"
